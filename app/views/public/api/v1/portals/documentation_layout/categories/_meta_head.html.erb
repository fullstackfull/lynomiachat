<%#
  One documentation category's head (docs/product-refinement/03-documentation-seo.md).

  A category page is a LIST, so it is `og:type: website` rather than `article`, and it carries no published or
  modified time -- the list has no publication date of its own, and inventing one from the newest article in it
  would be a number nobody stated.
%>
<% canonical_url = portal_category_canonical_url(portal, category) %>
<% meta_title = "#{category.name} | #{portal.display_title(category.locale)}" %>
<title><%= meta_title %></title>
<link rel="canonical" href="<%= canonical_url %>">
<meta name="title" content="<%= meta_title %>">
<% if category.description.present? %>
  <meta name="description" content="<%= category.description %>">
<% end %>

<meta property="og:type" content="website">
<meta property="og:url" content="<%= canonical_url %>">
<meta property="og:site_name" content="<%= portal.display_title(category.locale) %>">
<meta property="og:title" content="<%= meta_title %>">
<% if category.description.present? %>
  <meta property="og:description" content="<%= category.description %>">
<% end %>

<meta name="twitter:card" content="<%= og_image_url.present? ? 'summary_large_image' : 'summary' %>">
<meta name="twitter:title" content="<%= meta_title %>">
<% if category.description.present? %>
  <meta name="twitter:description" content="<%= category.description %>">
<% end %>
<% if og_image_url.present? %>
  <meta property="og:image" content="<%= og_image_url.html_safe %>">
  <meta name="twitter:image" content="<%= og_image_url.html_safe %>">
<% end %>
