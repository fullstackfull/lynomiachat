<%#
# Navigation

This partial is used to display the navigation in Administrate.
By default, the navigation contains navigation links
for all resources in the admin dashboard,
as defined by the routes in the `admin/` namespace
%>

<%= vite_client_tag %>
<%= vite_javascript_tag 'superadmin_pages' %>

<%
  sidebar_icons = {
    accounts: 'icon-building-4-line',
    users: 'icon-user-follow-line',
    platform_apps: 'icon-apps-2-line',
    agent_bots: 'icon-robot-line',
    platform_banners: 'icon-megaphone-line',
    billing_plans: 'icon-apps-2-line',
    portals: 'icon-book-line',
    categories: 'icon-folder-line',
    articles: 'icon-article-line',
    site_quote_requests: 'icon-draft-line',
    site_pages: 'icon-book-2-line',
    site_nav_links: 'icon-folder-3-line',
    site_faq_entries: 'icon-message-line',
    site_redirects: 'icon-refresh-line',
  }
%>

<div class="border-slate-100 border-r w-56 flex-shrink-0 justify-between h-full flex flex-col" role="navigation">
  <div>
    <div class="flex mx-4 mb-4 border-slate-100 border-b py-6">
      <%= link_to image_tag('/brand-assets/logo_thumbnail.svg', alt: 'Chatwoot Admin Dashboard', class: 'h-10'), super_admin_root_url %>
      <div class="flex flex-col ml-3">
        <div class="text-sm">Chatwoot <%= Chatwoot.config[:version] %></div>
        <div class="text-xs text-slate-700 mt-0.5">Super Admin Console</div>
      </div>
    </div>

    <ul class="my-4">
      <%= render partial: "nav_item", locals: { icon: 'icon-grid-line', url: super_admin_root_url, label: 'Dashboard' } %>
      <% Administrate::Namespace.new(namespace).resources.each do |resource| %>
        <%#
          Administrate enumerates EVERY controller under super_admin/ from the route table and asks each one
          for an index route and a dashboard. A controller that has neither -- which is every hand-written
          page on this surface -- raises here, and the raise breaks this partial on EVERY Super Admin page,
          not just its own. So each such controller is excluded by name, and the exclusion ships in the same
          commit as the route and the nav item.
        %>
        <% next if ["account_users", "access_tokens", "installation_configs", "dashboard", "devise/sessions", "app_configs", "instance_statuses", "settings", "push_diagnostics", "operations", "platform_support", "platform_support_actions", "partner_integrations", "documentation_media", "marketing_settings"].include?  resource.resource %>
        <% next if resource.resource == "platform_banners" && !ChatwootApp.chatwoot_cloud? %>
        <%= render partial: "nav_item", locals: {
            icon: sidebar_icons[resource.resource.to_sym],
            url: resource_index_route(resource),
            label: display_resource_name(resource),
          }
        %>

      <% end %>
      <%= render partial: "nav_item", locals: { icon: 'icon-mist-fill', url: settings_super_admin_billing_plans_url, label: 'Billing Settings' } %>
      <%= render 'settings_menu', open: settings_open? %>
    </ul>
  </div>
  <div>
    <ul class="my-4">
      <%= render partial: "nav_item", locals: { icon: 'icon-menu-search-line', url: super_admin_operations_url, label: 'Operations' } %>
      <%#
        Partner integrations (P6C). Beside Operations because it answers the same kind of
        question -- what needs attention -- for the installations a partner holds rather than
        for the workspace at large.
      %>
      <%= render partial: "nav_item", locals: { icon: 'icon-link', url: super_admin_partner_integrations_url, label: 'Partner Integrations' } %>
      <%# The Platform Support Desk: tickets Lynomia's own customers raised about Lynomia
          (docs/platform-support/05-super-admin-operations.md §1). In the lower operator block beside
          Operations, because it is an operator console and not a record type. The icon id must exist in
          _icons.html.erb or the item renders a blank square. %>
      <%= render partial: "nav_item", locals: { icon: 'icon-chat-smile-3-line', url: super_admin_platform_support_url, label: 'Customer Support' } %>
      <%= render partial: "nav_item", locals: { icon: 'icon-mist-fill', url: sidekiq_web_url, label: 'Sidekiq Dashboard' } %>
      <%= render partial: "nav_item", locals: { icon: 'icon-health-book-line', url: super_admin_instance_status_url, label: 'Instance Health' } %>
      <%= render partial: "nav_item", locals: { icon: 'icon-mail-send-fill', url: super_admin_push_diagnostics_url, label: 'Push Diagnostics' } %>
      <%# `/app`, NOT `/`. `/` is the marketing homepage on this installation's own host since the cutover
        (config/routes.rb:17), so an operator clicking this landed on the public website instead of the
        product. `/app` is the dashboard's own address and is what `/` used to bounce to anyway. %>
      <%= render partial: "nav_item", locals: { icon: 'icon-dashboard-line', url: '/app', label: 'Agent Dashboard' } %>
      <%= render partial: "nav_item", locals: { icon: 'icon-logout-circle-r-line', url: super_admin_logout_url, label: 'Logout' } %>
    </ul>
  </div>
</div>