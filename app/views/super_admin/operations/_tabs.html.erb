<nav class="flex flex-wrap gap-1 mb-6 border-b border-slate-100" role="navigation">
  <%#
    Ordered the way an operator works: what is wrong, what I am doing about it, then the three places the
    answer lives (accounts, channels, stores), then the raw feed.
  %>
  <%
    tabs = [
      ['Overview', super_admin_operations_path],
      ['Queue', queue_super_admin_operations_path],
      ['Accounts', accounts_super_admin_operations_path],
      ['Channels', channels_super_admin_operations_path],
      ['Commerce', commerce_super_admin_operations_path],
      ['Issues', issues_super_admin_operations_path]
    ]
  %>
  <% tabs.each do |label, url| %>
    <% active = current_page?(url) %>
    <%= link_to label, url,
                class: "px-3 py-2 text-sm border-b-2 #{active ? 'border-woot-500 text-woot-500' : 'border-transparent text-slate-600 hover:text-woot-500'}" %>
  <% end %>
</nav>
