<%#
  The channel matrix (docs/product-refinement/10-operations-ui.md §channels).

  The row that matters most on this page is the one that says nothing: five of the twelve channel types in this
  fork have no health source at all, and they read `unknown` forever rather than drifting to green because
  nobody has complained.
%>
<% content_for(:title) do %>Operations channels<% end %>

<header class="main-content__header" role="banner">
  <h1 class="main-content__page-title" id="page-title">Operations</h1>
</header>

<section class="main-content__body">
  <%= render 'tabs' %>

  <p class="text-sm text-slate-600 mb-4">
    What this installation can actually tell you about each kind of channel. <strong>No recent error is not
    health</strong>: a channel type with no health source reads <strong>unknown</strong> however long it has
    been quiet, and only a type with real evidence &mdash; the reauthorization latch, a stored token expiry, or
    the provider's own reading &mdash; can read healthy. Each row names the evidence it has.
  </p>

  <div class="border border-slate-100 rounded-md px-4 mb-8">
    <% @matrix[:rows].each do |row| %>
      <div class="flex items-start justify-between gap-4 border-b border-slate-100 py-2 last:border-b-0">
        <div class="min-w-0">
          <p class="text-sm text-slate-800">
            <%= row[:entry].key.to_s.humanize %>
            <span class="text-xs text-slate-400 ms-1"><%= row[:entry].channel_type %></span>
          </p>
          <% if row[:component].reason.present? %>
            <p class="text-xs text-slate-600 mt-0.5"><%= row[:component].reason %></p>
          <% end %>
          <p class="text-xs text-slate-400 mt-0.5 font-mono break-all">
            inboxes=<%= row[:inboxes] %>
            evidence=<%= row[:entry].health_sources.presence&.join(',') || 'none' %>
            identity=<%= row[:entry].identity %>
            connection=<%= row[:entry].connection %>
          </p>
        </div>
        <div class="flex items-center gap-2 flex-shrink-0">
          <span class="text-xs text-slate-400"><%= row[:component].source_class %></span>
          <%= render 'status_badge', status: row[:component].status %>
          <% if row[:component].investigate.present? %>
            <%= link_to 'Investigate', row[:component].investigate, class: 'text-xs text-woot-500 hover:underline' %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <h2 class="text-base font-semibold mb-1">Inboxes with a recorded problem</h2>
  <p class="text-xs text-slate-500 mb-2">
    The durable record, not a live probe: one row per open problem observed against an inbox. The live
    per-inbox reading is on that account's 360 page, where it costs one account rather than all of them.
  </p>
  <% if @matrix[:problem_inboxes].empty? %>
    <p class="text-sm text-slate-500 border border-slate-100 rounded-md p-4">
      Nothing is recorded against any inbox. For the
      <%= pluralize(@matrix[:unreported].length, 'channel type') %> above with no health source, that is not
      the same as working.
    </p>
  <% else %>
    <%= render 'signals', signals: @matrix[:problem_inboxes], show_actions: false %>
  <% end %>
</section>
