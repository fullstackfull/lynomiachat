<%#
  One incident, in full (docs/product-refinement/07-operations-control-center-v2.md §3).

  Four questions in order, because that is the order an operator asks them: what is it, who does it affect,
  what has happened to it, and what may I safely do. Nothing on this page exposes a credential: the signal's
  `reason` and `detail` were bounded and redacted by Operations::SignalRecorder on the way in, and there is no
  raw provider payload anywhere in the model to render.
%>
<% content_for(:page_title) { "Operations — #{@signal.signal.humanize}" } %>

<section class="p-6 max-w-5xl">
  <%= link_to '← Back to queue', queue_super_admin_operations_path, class: 'text-sm text-woot-500' %>

  <header class="mt-3 mb-5 flex items-start justify-between gap-4">
    <div>
      <h1 class="text-xl font-medium text-slate-900"><%= @signal.signal.humanize %></h1>
      <p class="text-sm text-slate-600 mt-1"><%= @signal.source.humanize %> &middot; signal #<%= @signal.id %></p>
    </div>
    <div class="flex gap-2">
      <%= render 'severity_badge', severity: @signal.severity %>
      <%= render 'handling_badge', state: @signal.handling_state %>
    </div>
  </header>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
    <div class="border border-slate-200 rounded-lg p-4">
      <h2 class="text-sm font-medium text-slate-900 mb-3">What happened</h2>
      <dl class="text-sm space-y-2">
        <div class="flex justify-between gap-4">
          <dt class="text-slate-600">Reason</dt>
          <dd class="text-slate-900 text-end"><%= @signal.reason.presence || '—' %></dd>
        </div>
        <div class="flex justify-between gap-4">
          <dt class="text-slate-600">First detected</dt>
          <dd class="text-slate-900"><%= @signal.first_seen_at.to_fs(:long) %></dd>
        </div>
        <div class="flex justify-between gap-4">
          <dt class="text-slate-600">Last detected</dt>
          <dd class="text-slate-900"><%= @signal.last_seen_at.to_fs(:long) %></dd>
        </div>
        <div class="flex justify-between gap-4">
          <dt class="text-slate-600">Observed</dt>
          <dd class="text-slate-900"><%= pluralize(@signal.occurrences, 'time') %></dd>
        </div>
        <div class="flex justify-between gap-4">
          <dt class="text-slate-600">Current state</dt>
          <dd class="text-slate-900"><%= @signal.open? ? 'Open' : "Recovered #{time_ago_in_words(@signal.resolved_at)} ago" %></dd>
        </div>
      </dl>

      <% if @signal.detail.present? %>
        <h3 class="text-xs font-medium text-slate-600 mt-4 mb-2">Evidence</h3>
        <dl class="text-xs space-y-1">
          <% @signal.detail.each do |key, value| %>
            <div class="flex justify-between gap-4">
              <dt class="text-slate-500"><%= key.humanize %></dt>
              <dd class="text-slate-800"><%= value %></dd>
            </div>
          <% end %>
        </dl>
      <% end %>
    </div>

    <div class="border border-slate-200 rounded-lg p-4">
      <h2 class="text-sm font-medium text-slate-900 mb-3">Who is affected</h2>
      <% if @signal.account %>
        <dl class="text-sm space-y-2">
          <div class="flex justify-between gap-4">
            <dt class="text-slate-600">Account</dt>
            <dd><%= link_to @signal.account.name, super_admin_account_path(@signal.account), class: 'text-woot-500' %></dd>
          </div>
          <div class="flex justify-between gap-4">
            <dt class="text-slate-600">Account id</dt>
            <dd class="text-slate-900"><%= @signal.account_id %></dd>
          </div>
          <div class="flex justify-between gap-4">
            <dt class="text-slate-600">Account status</dt>
            <dd class="text-slate-900"><%= @signal.account.status.humanize %></dd>
          </div>
        </dl>
        <div class="mt-4 flex flex-wrap gap-3 text-sm">
          <%= link_to 'Open account', super_admin_account_path(@signal.account), class: 'text-woot-500' %>
          <%= link_to 'Account health', accounts_super_admin_operations_path(q: @signal.account_id), class: 'text-woot-500' %>
        </div>
      <% else %>
        <p class="text-sm text-slate-600">
          Installation wide. This is not one customer's problem &mdash; it affects the platform, so it cannot
          be opened as an account support case.
        </p>
      <% end %>

      <% if @signal.subject_type.present? %>
        <h3 class="text-xs font-medium text-slate-600 mt-4 mb-1">Subject</h3>
        <p class="text-sm text-slate-800"><%= @signal.subject_type %> #<%= @signal.subject_id %></p>
      <% end %>

      <% if @signal.support_ticket %>
        <h3 class="text-xs font-medium text-slate-600 mt-4 mb-1">Support case</h3>
        <p class="text-sm text-slate-800"><%= @signal.support_ticket.reference %></p>
      <% end %>
    </div>
  </div>

  <%# The operator actions. Each is a POST through Operations::SignalLifecycle, which is the only writer, takes
      the operator explicitly and audits. Suppression asks for a reason and a deadline because both are
      required by the service -- an indefinite, unexplained mute is how a real problem disappears. %>
  <div class="border border-slate-200 rounded-lg p-4 mb-6">
    <h2 class="text-sm font-medium text-slate-900 mb-1">What you can do</h2>
    <p class="text-xs text-slate-600 mb-4">
      None of these resolves the signal. Only the product observing the thing working again does that, which is
      why a recovered signal is evidence and an acknowledgement is not.
    </p>

    <% if @signal.open? %>
      <div class="flex flex-wrap items-end gap-6">
        <% unless @signal.acknowledged? %>
          <%= form_with url: acknowledge_signal_super_admin_operations_path, method: :post, class: 'flex items-end gap-2' do |form| %>
            <%= form.hidden_field :id, value: @signal.id %>
            <div>
              <%= form.label :reason, 'Acknowledge', class: 'block text-xs text-slate-600 mb-1' %>
              <%= form.text_field :reason, placeholder: 'optional note',
                                  class: 'border border-slate-200 rounded-md px-2 py-1 text-sm w-56' %>
            </div>
            <%= form.submit 'I am on it', class: 'bg-woot-500 text-white rounded-md px-3 py-1.5 text-sm cursor-pointer' %>
          <% end %>
        <% end %>

        <%= form_with url: suppress_signal_super_admin_operations_path, method: :post, class: 'flex items-end gap-2' do |form| %>
          <%= form.hidden_field :id, value: @signal.id %>
          <div>
            <%= form.label :suppressed_until, 'Suppress until', class: 'block text-xs text-slate-600 mb-1' %>
            <%= form.datetime_field :suppressed_until, value: 1.day.from_now.strftime('%Y-%m-%dT%H:%M'),
                                    class: 'border border-slate-200 rounded-md px-2 py-1 text-sm' %>
          </div>
          <div>
            <%= form.label :reason, 'Reason (required)', class: 'block text-xs text-slate-600 mb-1' %>
            <%= form.text_field :reason, required: true, placeholder: 'why this is known and noisy',
                                class: 'border border-slate-200 rounded-md px-2 py-1 text-sm w-64' %>
          </div>
          <%= form.submit 'Suppress',
                          data: { confirm: 'This stops the signal being ranked until the time you chose. It does not fix it. Continue?' },
                          class: 'border border-slate-300 text-slate-700 rounded-md px-3 py-1.5 text-sm cursor-pointer' %>
        <% end %>

        <% if @signal.acknowledged? || @signal.suppressed_until.present? %>
          <%= form_with url: resume_signal_super_admin_operations_path, method: :post do |form| %>
            <%= form.hidden_field :id, value: @signal.id %>
            <%= form.submit 'Resume monitoring',
                            class: 'border border-slate-300 text-slate-700 rounded-md px-3 py-1.5 text-sm cursor-pointer' %>
          <% end %>
        <% end %>
      </div>

      <% if @signal.suppressed?(Time.current) %>
        <p class="text-xs text-slate-600 mt-4">
          Suppressed until <%= @signal.suppressed_until.to_fs(:long) %> &mdash;
          <%= @signal.suppression_reason %>. It returns to the queue by itself after that.
        </p>
      <% end %>
    <% else %>
      <p class="text-sm text-slate-600">This signal has recovered. There is nothing to act on.</p>
    <% end %>
  </div>

  <%#
    The incident lifecycle (docs/product-refinement/10-operations-ui.md §timeline).

    Distinct from the tenant's Audit Logs on purpose, and it does not duplicate them: those answer "who changed
    this account's product data" and are served to that account's own administrators. This is ONE incident's
    story, and the distinction it exists to draw is marked on every row &mdash; what the product OBSERVED
    (detected, recurred, recovered) against what a PERSON decided (acknowledged, suppressed, resumed, action
    taken, case opened). The observations are derived from the signal's own columns rather than stored again, so
    a problem seen a thousand times is one "recurred" row carrying the count (Operations::IncidentTimeline).
  %>
  <div class="border border-slate-200 rounded-lg p-4">
    <h2 class="text-sm font-medium text-slate-900 mb-1">Timeline</h2>
    <p class="text-xs text-slate-600 mb-4">
      <span class="inline-block w-2 h-2 rounded-full bg-slate-400 align-middle"></span> observed by the product
      &middot;
      <span class="inline-block w-2 h-2 rounded-full bg-woot-500 align-middle"></span> decided by an operator
    </p>
    <ol class="space-y-3">
      <% @timeline.each do |entry| %>
        <li class="flex gap-3 text-sm">
          <span class="text-xs text-slate-500 w-40 shrink-0"><%= entry.at.to_fs(:long) %></span>
          <span class="shrink-0 mt-1.5 w-2 h-2 rounded-full <%= entry.machine? ? 'bg-slate-400' : 'bg-woot-500' %>"></span>
          <span class="text-slate-900 min-w-0">
            <span class="font-medium"><%= entry.event_type.humanize %></span>
            <% if entry.actor_name.present? %>
              <span class="text-slate-600">by <%= entry.actor_name %></span>
            <% end %>
            <% if entry.reason.present? %>
              <span class="text-slate-600">&mdash; <%= entry.reason %></span>
            <% end %>
            <% if entry.detail.present? %>
              <span class="block text-xs text-slate-400 font-mono break-all">
                <%= entry.detail.map { |key, value| "#{key}=#{value}" }.join(' ') %>
              </span>
            <% end %>
          </span>
        </li>
      <% end %>
    </ol>
  </div>
</section>
