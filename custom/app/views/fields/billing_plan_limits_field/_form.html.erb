<div class="field-unit__label">
  <%= f.label field.attribute, 'Limits' %>
</div>
<div class="field-unit__field">
  <% BillingPlan::LIMIT_KEYS.each do |key| %>
    <div style="margin-bottom: 8px;">
      <label for="billing_plan_limits_<%= key %>"><%= field.label(key) %></label>
      <input type="number" min="0" step="1"
             id="billing_plan_limits_<%= key %>"
             name="<%= f.object_name %>[<%= field.attribute %>][<%= key %>]"
             value="<%= field.limits[key] %>"
             placeholder="Unlimited">
    </div>
  <% end %>
  <p style="font-size: 12px; opacity: .7;">Leave empty for unlimited. 0 = not allowed.</p>
  <p style="font-size: 12px; opacity: .7;">Commerce stores: stores an account keeps connected (any platform; disconnected stores do not count). Applies when the plan includes Lynomia Commerce.</p>
</div>
