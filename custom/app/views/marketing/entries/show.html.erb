<%# One template for every catalogue detail page -- feature, channel, and in later slices integration and
  solution.

  ONE TEMPLATE, NOT FORTY. The pages differ in content, not in shape: a name, its availability, what it does,
  what it needs before it works, where the documentation is, and which neighbours to read next. Forty
  near-identical ERB files would be forty places to fix the next time the prerequisite callout or the related
  block changes, and forty chances for one page to quietly stop stating its gate.

  THE PREREQUISITE IS PART OF THE PAGE, not a footnote. For a conditional feature the `requires` line is what
  makes the sentences above it true, and for a channel it is always rendered because every channel needs the
  customer's own provider account.
%>
<% entry_scope = @collection %>
<% key = "marketing.#{entry_scope}.#{@entry.id}" %>
<% detail = "#{key}.detail" %>

<article class="mx-auto max-w-4xl px-4 py-12 sm:px-6">
  <%= render 'marketing/shared/breadcrumb',
             trail: marketing_breadcrumb(entry_scope, t("#{key}.name")) %>

  <header>
    <h1 class="flex flex-wrap items-center gap-3 text-3xl font-bold text-slate-900 sm:text-4xl">
      <%= t("#{key}.name") %>
      <%= render 'marketing/shared/state_badge', state: @entry.state %>
    </h1>
    <p class="mt-4 text-lg leading-relaxed text-slate-600"><%= t("#{detail}.lede") %></p>
  </header>

  <% if t("#{key}.requires", default: nil).present? %>
    <div class="mt-8 rounded-2xl border border-yellow-200 bg-yellow-50 p-5">
      <h2 class="text-sm font-semibold text-yellow-900">
        <%= t(entry_scope == :channels ? 'marketing.state.you_supply' : 'marketing.state.requires') %>
      </h2>
      <p class="mt-1 text-sm leading-relaxed text-yellow-900"><%= t("#{key}.requires") %></p>
    </div>
  <% end %>

  <section class="mt-12">
    <h2 class="text-xl font-semibold text-slate-900"><%= t("#{detail}.points_title") %></h2>
    <div class="mt-6 grid gap-6 sm:grid-cols-2">
      <% t("#{detail}.points").each do |point| %>
        <div class="rounded-2xl border border-slate-100 bg-white p-5">
          <h3 class="text-base font-semibold text-slate-900"><%= point[:title] %></h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-600"><%= point[:body] %></p>
        </div>
      <% end %>
    </div>
  </section>

  <%# The honesty paragraph: what this page is NOT claiming. Optional, and present wherever the inventory
    recorded a neighbouring capability that does not exist or cannot be sold. %>
  <% if t("#{detail}.note", default: nil).present? %>
    <section class="mt-10 rounded-2xl bg-slate-25 p-5">
      <h2 class="text-sm font-semibold text-slate-900"><%= t('marketing.detail.note_title') %></h2>
      <p class="mt-1 text-sm leading-relaxed text-slate-600"><%= t("#{detail}.note") %></p>
    </section>
  <% end %>

  <% if @entry.docs %>
    <p class="mt-10">
      <a class="inline-flex items-center gap-2 rounded-xl border border-slate-200 px-4 py-2.5 text-sm font-medium text-slate-800 hover:bg-slate-50"
         href="<%= lynomia_docs_article_path(@entry.docs) %>">
        <%= t('marketing.read_docs') %>
      </a>
    </p>
  <% end %>

  <% if @entry.channel_ids.any? %>
    <section class="mt-12 border-t border-slate-100 pt-8">
      <h2 class="text-sm font-semibold text-slate-900"><%= t('marketing.detail.works_with') %></h2>
      <ul class="mt-3 flex flex-wrap gap-2">
        <% @entry.channel_ids.each do |channel_id| %>
          <% channel = Marketing::Catalog.channel(channel_id) %>
          <li>
            <a class="inline-block rounded-full border border-slate-200 px-3 py-1 text-sm text-slate-700 hover:bg-slate-50"
               href="<%= marketing_entry_path(:channels, channel) %>">
              <%= t("marketing.channels.#{channel.id}.name") %>
            </a>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <% if @entry.related_ids.any? %>
    <section class="mt-10 border-t border-slate-100 pt-8">
      <h2 class="text-sm font-semibold text-slate-900"><%= t('marketing.detail.read_next') %></h2>
      <div class="mt-4 grid gap-4 sm:grid-cols-3">
        <% @entry.related_ids.each do |feature_id| %>
          <% feature = Marketing::Catalog.feature(feature_id) %>
          <a class="rounded-2xl border border-slate-100 p-4 hover:border-slate-200 hover:bg-slate-25"
             href="<%= marketing_entry_path(:features, feature) %>">
            <span class="block text-sm font-semibold text-slate-900"><%= t("marketing.features.#{feature.id}.name") %></span>
            <span class="mt-1 block text-xs leading-relaxed text-slate-600"><%= t("marketing.features.#{feature.id}.summary") %></span>
          </a>
        <% end %>
      </div>
    </section>
  <% end %>

  <%= render 'marketing/shared/cta' %>
</article>
