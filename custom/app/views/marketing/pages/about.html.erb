<%# About.

  NO COMPANY FACTS ARE INVENTED HERE. There is no founding year, no headcount, no office address, no customer
  count and no logo wall, because none of those is established anywhere this site can check. What the page
  says instead is what is verifiable and, as it happens, what actually distinguishes this product: how it is
  built, how it talks about itself, and that the Arabic version is the original rather than a translation.
%>
<section class="mx-auto max-w-3xl px-4 py-14 sm:px-6">
  <h1 class="text-3xl font-bold text-slate-900 sm:text-4xl"><%= t('marketing.pages.about.heading') %></h1>
  <p class="mt-4 text-lg leading-relaxed text-slate-600"><%= t('marketing.pages.about.lede') %></p>

  <div class="mt-10 space-y-8">
    <% %w[product honesty arabic company].each do |section| %>
      <section>
        <h2 class="text-xl font-semibold text-slate-900"><%= t("marketing.about.#{section}.title") %></h2>
        <p class="mt-2 leading-relaxed text-slate-600"><%= t("marketing.about.#{section}.body") %></p>
      </section>
    <% end %>
  </div>

  <div class="mt-10 flex flex-wrap gap-3">
    <a href="<%= marketing_path(:features) %>"
       class="rounded-xl border border-slate-200 px-5 py-3 text-sm font-semibold text-slate-700 hover:bg-slate-50">
      <%= t('marketing.about.see_features') %>
    </a>
    <a href="<%= MarketingHelper::LEGAL_LINKS[:about] %>" target="_blank" rel="noopener"
       class="rounded-xl border border-slate-200 px-5 py-3 text-sm font-semibold text-slate-700 hover:bg-slate-50">
      <%= t('marketing.about.company_site') %>
    </a>
  </div>
</section>
