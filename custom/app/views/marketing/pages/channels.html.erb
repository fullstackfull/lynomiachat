<%# The channels index. Nine connectable channels plus TikTok in beta -- the honest count, with every
  prerequisite stated. Twitter/X, voice calling and 360dialog are absent on purpose: the inventory could not
  establish a usable connect path for any of them. %>
<section class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
  <h1 class="text-3xl font-bold text-slate-900 sm:text-4xl"><%= t('marketing.pages.channels.heading') %></h1>
  <p class="mt-4 max-w-2xl text-base leading-relaxed text-slate-600"><%= t('marketing.pages.channels.lede') %></p>

  <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    <% Marketing::Catalog.channels.each do |channel| %>
      <article class="flex flex-col rounded-2xl border border-slate-100 bg-white p-5">
        <h2 class="flex flex-wrap items-center gap-2 text-base font-semibold text-slate-900">
          <%= t("marketing.channels.#{channel.id}.name") %>
          <%= render 'marketing/shared/state_badge', state: channel.state %>
        </h2>
        <p class="mt-2 grow text-sm leading-relaxed text-slate-600"><%= t("marketing.channels.#{channel.id}.summary") %></p>
        <p class="mt-3 rounded-lg bg-slate-25 px-3 py-2 text-xs leading-relaxed text-slate-600">
          <span class="font-medium"><%= t('marketing.state.you_supply') %></span>
          <%= t("marketing.channels.#{channel.id}.requires") %>
        </p>
        <% if channel.docs %>
          <a class="mt-4 text-sm font-medium text-woot-600 hover:text-woot-700"
             href="<%= lynomia_docs_article_path(channel.docs) %>">
            <%= t('marketing.read_docs') %>
          </a>
        <% end %>
      </article>
    <% end %>
  </div>
</section>
