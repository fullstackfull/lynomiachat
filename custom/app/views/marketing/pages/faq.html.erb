<%# Frequently asked questions.

  Each answer is two or three sentences and a link to the page that answers it properly -- an FAQ that
  restates a feature page is duplicate content competing with its own source. The JSON-LD FAQPage that
  mirrors this list is W5.

  FOUR OF THESE QUESTIONS HAVE A NO FOR AN ANSWER: the AI chatbot, the price list, the free trial and the
  certifications. They are here precisely for that reason. A site that leaves out the questions whose honest
  answer is a qualification has still answered them, just not truthfully.
%>
<section class="mx-auto max-w-3xl px-4 py-14 sm:px-6">
  <h1 class="text-3xl font-bold text-slate-900 sm:text-4xl"><%= t('marketing.pages.faq.heading') %></h1>
  <p class="mt-4 text-base leading-relaxed text-slate-600"><%= t('marketing.pages.faq.lede') %></p>

  <dl class="mt-10 divide-y divide-slate-100">
    <% Marketing::Faq.entries.each do |entry| %>
      <div class="py-6">
        <dt class="text-lg font-semibold text-slate-900"><%= t("marketing.faq.#{entry.id}.question") %></dt>
        <dd class="mt-2 leading-relaxed text-slate-600">
          <%= t("marketing.faq.#{entry.id}.answer") %>
          <a class="mt-2 block text-sm font-medium text-woot-600 hover:text-woot-700"
             href="<%= marketing_faq_href(entry.link) %>">
            <%= t("marketing.faq.#{entry.id}.link_label") %>
          </a>
        </dd>
      </div>
    <% end %>
  </dl>
</section>

<%= render 'marketing/shared/cta' %>
