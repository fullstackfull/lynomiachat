<%# The features index: the full verified catalogue, each with its state. %>
<section class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
  <h1 class="text-3xl font-bold text-slate-900 sm:text-4xl"><%= t('marketing.pages.features.heading') %></h1>
  <p class="mt-4 max-w-2xl text-base leading-relaxed text-slate-600"><%= t('marketing.pages.features.lede') %></p>

  <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    <% Marketing::Catalog.features.each do |feature| %>
      <article class="flex flex-col rounded-2xl border border-slate-100 bg-white p-5">
        <h2 class="flex flex-wrap items-center gap-2 text-base font-semibold text-slate-900">
          <%= t("marketing.features.#{feature.id}.name") %>
          <%= render 'marketing/shared/state_badge', state: feature.state %>
        </h2>
        <p class="mt-2 grow text-sm leading-relaxed text-slate-600"><%= t("marketing.features.#{feature.id}.summary") %></p>
        <% if feature.state == :conditional %>
          <p class="mt-3 rounded-lg bg-slate-25 px-3 py-2 text-xs leading-relaxed text-slate-600">
            <span class="font-medium"><%= t('marketing.state.requires') %></span>
            <%= t("marketing.features.#{feature.id}.requires") %>
          </p>
        <% end %>
        <% if feature.docs %>
          <a class="mt-4 text-sm font-medium text-woot-600 hover:text-woot-700"
             href="<%= lynomia_docs_article_path(feature.docs) %>">
            <%= t('marketing.read_docs') %>
          </a>
        <% end %>
      </article>
    <% end %>
  </div>
</section>
