<%# The features index: the full verified catalogue, each with its state and its own page. %>
<section class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
  <h1 class="text-3xl font-bold text-slate-900 sm:text-4xl"><%= t('marketing.pages.features.heading') %></h1>
  <p class="mt-4 max-w-2xl text-base leading-relaxed text-slate-600"><%= t('marketing.pages.features.lede') %></p>

  <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    <% Marketing::Catalog.features.each do |feature| %>
      <%= render 'marketing/shared/entry_card', entry: feature, scope: :features %>
    <% end %>
  </div>
</section>
