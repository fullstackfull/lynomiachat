<%# The integrations index.

  Channel providers are not listed here -- Twilio, Bandwidth, Meta, LINE and Telegram are how a channel is
  connected and they live on the channel's own page. Webhooks and dashboard apps are the API feature. Both are
  linked from the lede instead of being restated, so two pages do not compete for the same search with the
  same sentences.
%>
<section class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
  <h1 class="text-3xl font-bold text-slate-900 sm:text-4xl"><%= t('marketing.pages.integrations.heading') %></h1>
  <p class="mt-4 max-w-2xl text-base leading-relaxed text-slate-600"><%= t('marketing.pages.integrations.lede') %></p>

  <p class="mt-4 max-w-2xl text-sm leading-relaxed text-slate-600">
    <%= t('marketing.pages.integrations.elsewhere_html',
          channels: link_to(t('marketing.nav.channels'), marketing_path(:channels),
                            class: 'font-medium text-woot-600 hover:text-woot-700'),
          api: link_to(t('marketing.features.api_webhooks.name'),
                       marketing_entry_path(:features, Marketing::Catalog.feature(:api_webhooks)),
                       class: 'font-medium text-woot-600 hover:text-woot-700')) %>
  </p>

  <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    <% Marketing::Catalog.integrations.each do |integration| %>
      <%= render 'marketing/shared/entry_card', entry: integration, scope: :integrations %>
    <% end %>
  </div>
</section>
