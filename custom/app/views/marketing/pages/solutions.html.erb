<%# The solutions index.

  A solution page says nothing new about the product: it names which verified capabilities serve a particular
  job and what each needs. That is the constraint that stops an audience page becoming the one place on the
  site where an unverified promise appears.
%>
<section class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
  <h1 class="text-3xl font-bold text-slate-900 sm:text-4xl"><%= t('marketing.pages.solutions.heading') %></h1>
  <p class="mt-4 max-w-2xl text-base leading-relaxed text-slate-600"><%= t('marketing.pages.solutions.lede') %></p>

  <div class="mt-10 grid gap-4 sm:grid-cols-2">
    <% Marketing::Catalog.solutions.each do |solution| %>
      <%= render 'marketing/shared/entry_card', entry: solution, scope: :solutions %>
    <% end %>
  </div>
</section>
