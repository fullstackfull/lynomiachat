<%# The support page.

  It is honest about a real constraint: there is no account-less ticket URL and no post-login return
  destination (docs/official-website/02-verified-feature-inventory.md section 5). So "open a ticket" is
  presented as a sign-in-first action and labelled as one, rather than as a link that silently fails for
  anyone who is not already signed in to the right account. %>
<section class="mx-auto max-w-4xl px-4 py-14 sm:px-6">
  <h1 class="text-3xl font-bold text-slate-900 sm:text-4xl"><%= t('marketing.pages.support.heading') %></h1>
  <p class="mt-4 text-base leading-relaxed text-slate-600"><%= t('marketing.pages.support.lede') %></p>

  <div class="mt-10 grid gap-4 sm:grid-cols-2">
    <article class="rounded-2xl border border-slate-100 p-6">
      <h2 class="text-lg font-semibold text-slate-900"><%= t('marketing.support.docs_title') %></h2>
      <p class="mt-2 text-sm leading-relaxed text-slate-600"><%= t('marketing.support.docs_body') %></p>
      <a class="mt-4 inline-block text-sm font-medium text-woot-600 hover:text-woot-700" href="<%= lynomia_docs_path %>">
        <%= t('marketing.support.docs_cta') %>
      </a>
    </article>

    <article class="rounded-2xl border border-slate-100 p-6">
      <h2 class="text-lg font-semibold text-slate-900"><%= t('marketing.support.ticket_title') %></h2>
      <p class="mt-2 text-sm leading-relaxed text-slate-600"><%= t('marketing.support.ticket_body') %></p>
      <a class="mt-4 inline-block text-sm font-medium text-woot-600 hover:text-woot-700" href="/app/login">
        <%= t('marketing.support.ticket_cta') %>
      </a>
    </article>

    <article class="rounded-2xl border border-slate-100 p-6">
      <h2 class="text-lg font-semibold text-slate-900"><%= t('marketing.support.email_title') %></h2>
      <p class="mt-2 text-sm leading-relaxed text-slate-600"><%= t('marketing.support.email_body') %></p>
      <a class="mt-4 inline-block text-sm font-medium text-woot-600 hover:text-woot-700"
         href="<%= marketing_support_email_url %>">
        <%= MarketingHelper::SUPPORT_EMAIL %>
      </a>
    </article>

    <article class="rounded-2xl border border-slate-100 p-6">
      <h2 class="text-lg font-semibold text-slate-900"><%= t('marketing.support.changelog_title') %></h2>
      <p class="mt-2 text-sm leading-relaxed text-slate-600"><%= t('marketing.support.changelog_body') %></p>
      <a class="mt-4 inline-block text-sm font-medium text-woot-600 hover:text-woot-700"
         href="<%= lynomia_changelog_path %>">
        <%= t('marketing.support.changelog_cta') %>
      </a>
    </article>
  </div>
</section>
