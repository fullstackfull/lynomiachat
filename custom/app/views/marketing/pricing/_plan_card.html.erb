<%# ONE PLAN, AS A BUYER NEEDS TO SEE IT.

  Everything here is a column on the row: the name, the price, the interval, the ceilings, the channels and
  the capabilities. Nothing is written into this template, which is why ticking a feature in Super Admin
  changes this card on the next request and no deploy is involved.

  THE CARD SHOWS CAPABILITIES BEFORE IT HIDES ANY. The brief this answers was explicit that two visible
  bullets with everything else behind a collapsed panel is not a pricing card. So the most important few are
  printed, the count of the rest is stated, and the full grouped list is one click away -- in a <details>,
  which is a real disclosure widget with real keyboard behaviour and NO JavaScript. The marketing bundle
  loads none (app/javascript/entrypoints/marketing.js is one import), and this page is not where that
  changes.

  THE CTA IS A FACT, NOT A TONE. `offer.purchasable?` is Billing::PlanOffer's answer, and it is false when
  Stripe is unconfigured or the plan has no price mapping. A card that cannot take money says so and sends
  the reader to the quote form, because a Subscribe button that dead-ends costs more trust than it wins.
%>
<% offer = Billing::PlanOffer.new(plan) %>
<% channels = marketing_plan_channels(plan) %>
<% capabilities = Marketing::PlanFeatures.for_plan(plan, locale: marketing_locale) %>
<% headline = capabilities.first(Marketing::PricingHelper::CARD_CAPABILITIES) %>

<article class="flex h-full flex-col rounded-3xl border border-lyn-line bg-lyn-paper p-7 shadow-[0_24px_60px_-40px_rgba(10,23,51,0.45)] transition-shadow hover:shadow-[0_28px_70px_-36px_rgba(10,23,51,0.55)]">
  <h3 class="text-xl font-semibold tracking-tight text-lyn-ink"><%= plan.name %></h3>

  <%# `tabular-nums` so a row of prices lines up, and `dir="ltr"` because a currency code before a figure is
      read left-to-right in both languages. %>
  <p class="mt-5 flex flex-wrap items-baseline gap-x-2 gap-y-1" dir="ltr">
    <span class="text-[2.5rem] font-bold leading-none tracking-tight tabular-nums text-lyn-ink">
      <%= marketing_plan_price(plan) %>
    </span>
  </p>
  <p class="mt-2 text-sm text-lyn-ink-soft">
    <%= t("marketing.pricing.interval.#{plan.interval}") %><%= " · #{t('marketing.pricing.per_agent')}" if plan.pricing_type == 'per_agent' %>
  </p>

  <% if plan.description.present? %>
    <p class="mt-5 text-[0.95rem] leading-[1.8] text-lyn-ink-soft"><%= plan.description %></p>
  <% end %>

  <% if plan.limits.any? %>
    <ul class="mt-6 space-y-2.5 border-t border-lyn-line pt-6">
      <%# IN THE MODEL'S OWN ORDER, not the jsonb's, so three cards list their ceilings in the same order. %>
      <% BillingPlan::LIMIT_KEYS.each do |key| %>
        <% value = plan.limits[key] %>
        <% next if value.blank? %>
        <li class="flex items-start gap-2.5 text-[0.95rem] leading-relaxed text-lyn-ink">
          <%= render 'marketing/pricing/tick' %>
          <%= t("marketing.pricing.limits.#{key}", count: value) %>
        </li>
      <% end %>
    </ul>
  <% end %>

  <%# WHAT THE PLAN ACTUALLY INCLUDES. Absent entirely when the plan has no capabilities ticked: an empty
      "What's included" heading reads as a plan that includes nothing, which is a different claim from one
      whose operator has not filled the field in. %>
  <% if capabilities.any? %>
    <div class="mt-6 border-t border-lyn-line pt-6">
      <p class="text-xs font-semibold uppercase tracking-[0.12em] text-lyn-ink-soft/70">
        <%= t('marketing.pricing.included_features') %>
      </p>
      <ul class="mt-3 space-y-2.5">
        <% headline.each do |capability| %>
          <li class="flex items-start gap-2.5 text-[0.95rem] leading-relaxed text-lyn-ink">
            <%= render 'marketing/pricing/tick' %>
            <%= capability.label %>
          </li>
        <% end %>
      </ul>

      <% remaining = capabilities.length - headline.length %>
      <% if remaining.positive? %>
        <p class="mt-2.5 text-sm text-lyn-ink-soft"><%= t('marketing.pricing.more_features', count: remaining) %></p>
      <% end %>

      <%# A NATIVE DISCLOSURE. <details> opens and closes, is reachable by keyboard, is announced as a
          disclosure, and prints open -- all without a line of script. `marker:hidden` removes the default
          triangle so the chevron below is the only affordance; the summary keeps its own focus ring. %>
      <details class="group mt-4">
        <summary class="inline-flex cursor-pointer list-none items-center gap-1.5 rounded text-sm font-semibold text-lyn-royal marker:hidden hover:text-lyn-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-lyn-blue [&::-webkit-details-marker]:hidden">
          <%= t('marketing.pricing.view_all_features') %>
          <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24"
               class="size-4 flex-none transition-transform group-open:rotate-180" fill="none"
               stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
            <path d="m6 9 6 6 6-6"/>
          </svg>
        </summary>
        <div class="mt-4 space-y-4">
          <% Marketing::PlanFeatures.grouped(plan, locale: marketing_locale).each do |category, grouped| %>
            <div>
              <p class="text-xs font-semibold uppercase tracking-[0.12em] text-lyn-ink-soft/70">
                <%= Marketing::PlanFeatures.category_label(category, locale: marketing_locale) %>
              </p>
              <ul class="mt-2 space-y-2">
                <% grouped.each do |capability| %>
                  <li class="flex items-start gap-2.5 text-[0.95rem] leading-relaxed text-lyn-ink">
                    <%= render 'marketing/pricing/tick' %>
                    <%= capability.label %>
                  </li>
                <% end %>
              </ul>
            </div>
          <% end %>
        </div>
      </details>
    </div>
  <% end %>

  <%# WHICH CHANNELS THE PLAN SELLS, in their own marks. An empty entitlement list means every channel --
      the model's rule -- and that is said in a sentence rather than drawn as ten marks that read as a limit.
      `marketing_plan_channels` deduplicates by catalogue identity, which is what stopped "SMS" twice. %>
  <div class="mt-6 border-t border-lyn-line pt-6">
    <p class="text-xs font-semibold uppercase tracking-[0.12em] text-lyn-ink-soft/70">
      <%= t('marketing.pricing.plan_channels') %>
    </p>
    <% if channels.any? %>
      <ul class="mt-3 flex flex-wrap gap-2">
        <% channels.each do |channel| %>
          <li class="inline-flex items-center gap-2 rounded-full border border-lyn-line bg-lyn-mist py-1 pe-3 ps-1 text-sm font-medium text-lyn-ink">
            <%= render 'marketing/shared/channel_mark', id: channel.id, size: 24, labelled: false %>
            <%= t("marketing.channels.#{channel.id}.name") %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="mt-2 text-[0.95rem] leading-relaxed text-lyn-ink"><%= t('marketing.pricing.plan_channels_all') %></p>
    <% end %>
  </div>

  <%# `mt-auto` on the WRAPPER, not the button, so the gap lands above the control instead of inside it. %>
  <div class="mt-auto pt-7">
    <% if offer.purchasable? %>
      <a href="<%= marketing_plan_selection_path(plan_id: plan.id, locale: params[:locale]) %>"
         aria-label="<%= t('marketing.pricing.plan_cta_aria', name: plan.name) %>"
         class="inline-flex min-h-12 w-full items-center justify-center rounded-xl bg-lyn-indigo px-6 text-base font-semibold text-lyn-paper transition-colors hover:bg-lyn-indigo-deep focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-lyn-blue">
        <%= t('marketing.pricing.plan_cta') %>
      </a>
    <% else %>
      <a href="#quote"
         aria-label="<%= t('marketing.pricing.plan_cta_contact_aria', name: plan.name) %>"
         class="inline-flex min-h-12 w-full items-center justify-center rounded-xl bg-lyn-ink px-6 text-base font-semibold text-lyn-paper transition-colors hover:bg-lyn-royal focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-lyn-blue">
        <%= t('marketing.pricing.plan_cta_contact') %>
      </a>
    <% end %>
  </div>
</article>
