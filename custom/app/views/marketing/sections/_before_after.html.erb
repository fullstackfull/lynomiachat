<%# A CAPABILITY SHOWN BY WHAT IT DOES TO A MESSAGE.

  WHY NOT A SCREENSHOT. The assist actions live inside the composer and fire on text the agent has typed; a
  capture of the menu shows five labels and none of the result, which is the whole point. Two lines of real
  before-and-after say in two seconds what a picture of a dropdown cannot say at all. The lines are the
  operator's, in both languages, so a translator can make the improvement read as an improvement in Arabic
  rather than shipping an English joke nobody mirrors.

  THE GATE IS IN THE SECTION, NOT IN A FOOTNOTE. `note` renders directly under the heading, in the same type
  size as the standfirst, because every action here is off until an account connects its own key -- and a
  capability band that waits until the pricing page to mention that is the kind of claim this site exists to
  stop making.

  ON THE INK FIELD. Marketing::SectionSchema::INK_TYPES carries this type, so the band is dark wherever it is
  placed: the page gets a second beat of its ink/paper rhythm, and a before-and-after pair reads best as two
  plates lit against a dark field rather than as two more white cards among white cards.
%>
<% link = marketing_target_href(section['link_target']) %>
<% items = Array(section['items']).select { |item| item['before'].present? && item['after'].present? } %>

<section class="<%= tone %>">
  <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:py-24">
    <div class="mx-auto max-w-3xl text-center">
      <% if section['kicker'].present? %>
        <p class="text-sm font-semibold uppercase tracking-[0.12em] text-lyn-blue"><%= section['kicker'] %></p>
      <% end %>
      <% if section['heading'].present? %>
        <h2 class="mt-3 text-balance text-3xl font-semibold tracking-tight text-lyn-paper sm:text-4xl">
          <%= section['heading'] %>
        </h2>
      <% end %>
      <% if section['lede'].present? %>
        <p class="mt-5 text-lg leading-relaxed text-lyn-paper/70"><%= section['lede'] %></p>
      <% end %>
      <% if section['note'].present? %>
        <p class="mt-5 inline-flex rounded-xl border border-lyn-line-dark bg-lyn-ink/50 px-4 py-2.5 text-[0.95rem] leading-relaxed text-lyn-paper/65">
          <%= section['note'] %>
        </p>
      <% end %>
    </div>

    <% if items.any? %>
      <ul class="mt-14 grid gap-6 md:grid-cols-3">
        <% items.each do |item| %>
          <li class="rounded-2xl border border-lyn-line-dark bg-white/[0.045] p-6">
            <h3 class="text-base font-semibold text-lyn-paper"><%= item['title'] %></h3>

            <%# THE TWO STATES, stacked, with the arrow between them -- not two columns, which at 1/3 of the
                measure gives each line about 18 characters and turns a sentence into a word ladder. %>
            <p class="mt-5 rounded-xl bg-lyn-ink/60 px-4 py-3 text-[0.9rem] leading-relaxed text-lyn-paper/55" dir="auto">
              <%= item['before'] %>
            </p>
            <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24"
                 class="mx-auto my-2 size-5 text-lyn-blue/70" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 5v14m0 0 6-6m-6 6-6-6"/>
            </svg>
            <p class="rounded-xl bg-lyn-indigo/25 px-4 py-3 text-[0.9rem] leading-relaxed text-lyn-paper ring-1 ring-inset ring-lyn-indigo/35" dir="auto">
              <%= item['after'] %>
            </p>
          </li>
        <% end %>
      </ul>
    <% end %>

    <% if link.present? && section['link_label'].present? %>
      <div class="mt-12 text-center">
        <a href="<%= link %>"
           class="inline-flex min-h-11 items-center gap-2 text-base font-semibold text-lyn-blue transition-colors hover:text-lyn-paper focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-lyn-blue">
          <%= section['link_label'] %>
          <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" class="size-4 rtl:-scale-x-100"
               fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h13m0 0-5-5m5 5-5 5"/>
          </svg>
        </a>
      </div>
    <% end %>
  </div>
</section>
