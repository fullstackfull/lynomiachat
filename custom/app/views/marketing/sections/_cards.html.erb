<%# The workhorse: a grid of title/body cards, each optionally linking somewhere.

  A LINK WHOSE TARGET DOES NOT RESOLVE IS NOT RENDERED. `marketing_target_href` returns nil for a page that
  is unpublished or gone, and a card then shows its text without a link rather than an href="#" -- which is
  the defect the old footer had four of.
%>
<%# THE ITEM HEADING LEVEL FOLLOWS THE SECTION'S OWN. With a section heading the cards sit under an <h2> and
  are <h3>s; without one they are the first headings after the page's <h1> and must be <h2>s, or the document
  skips a level -- which is what the crawl measured on /contact, /support and /integrations in both locales.
%>
<% item_heading = section['heading'].present? ? 'h3' : 'h2' %>
<%# TWO COLUMNS IS WHAT A BLANK FIELD MEANS, and it is said once. The default used to be a second assignment
  after the clamp -- `columns = 2 if columns.zero?` -- which could never run, because `clamp(1, 3)` has no
  zero to find: an operator who left the field empty silently got a single column instead of the grid. The
  default now sits inside the same expression that bounds the value. %>
<% columns = (section['columns'].presence || 2).to_i.clamp(1, 3) %>
<section class="mt-16">
  <%= render 'marketing/shared/section_head', heading: section['heading'], lede: section['lede'] %>

  <div class="mt-7 grid gap-5 <%= columns == 3 ? 'sm:grid-cols-3' : (columns == 2 ? 'sm:grid-cols-2' : '') %>">
    <% Array(section['items']).each do |item| %>
      <% href = marketing_target_href(item['link_target']) %>
      <article class="rounded-2xl bg-lyn-mist p-6">
        <% if item['title'].present? %>
          <%= content_tag(item_heading, item['title'], class: 'text-base font-semibold text-lyn-ink') %>
        <% end %>
        <% if item['body'].present? %>
          <p class="mt-2 text-sm leading-[1.8] text-lyn-ink-soft"><%= item['body'] %></p>
        <% end %>
        <% if href.present? && item['link_label'].present? %>
          <a class="mt-4 inline-block text-sm font-semibold text-lyn-royal transition-colors hover:text-lyn-ink"
             href="<%= href %>"
             <%= 'target=_blank rel=noopener'.html_safe if marketing_target_external?(item['link_target']) %>>
            <%= item['link_label'] %>
          </a>
        <% end %>
      </article>
    <% end %>
  </div>
</section>
