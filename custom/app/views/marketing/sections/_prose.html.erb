<%# A heading and a paragraph. The About page is four of these, so they carry the page's reading rhythm and
  use the same section head as every other block. %>
<section class="mt-16">
  <%= render 'marketing/shared/section_head', heading: section['heading'], lede: nil %>
  <% if section['body'].present? %>
    <p class="mt-5 max-w-2xl text-base leading-[1.85] text-lyn-ink-soft"><%= section['body'] %></p>
  <% end %>
</section>
