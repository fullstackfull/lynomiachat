<%# One catalogue card, shared by every index.

  The card links to the entry's own page when it has one. TikTok is the single entry that does not: the
  inventory's verdict is "mention only, labelled beta", so it keeps its card, its badge and its prerequisite
  and links nowhere -- which is honest, and still not a dead link.
%>
<article class="flex flex-col rounded-2xl border border-slate-100 bg-white p-5">
  <h2 class="flex flex-wrap items-center gap-2 text-base font-semibold text-slate-900">
    <% if entry.detail? %>
      <a class="hover:text-woot-700" href="<%= marketing_entry_path(scope, entry) %>">
        <%= t("marketing.#{scope}.#{entry.id}.name") %>
      </a>
    <% else %>
      <%= t("marketing.#{scope}.#{entry.id}.name") %>
    <% end %>
    <%= render 'marketing/shared/state_badge', state: entry.state %>
  </h2>

  <p class="mt-2 grow text-sm leading-relaxed text-slate-600">
    <%= t("marketing.#{scope}.#{entry.id}.summary") %>
  </p>

  <% if t("marketing.#{scope}.#{entry.id}.requires", default: nil).present? %>
    <p class="mt-3 rounded-lg bg-slate-25 px-3 py-2 text-xs leading-relaxed text-slate-600">
      <span class="font-medium">
        <%= t(scope == :channels ? 'marketing.state.you_supply' : 'marketing.state.requires') %>
      </span>
      <%= t("marketing.#{scope}.#{entry.id}.requires") %>
    </p>
  <% end %>
</article>
