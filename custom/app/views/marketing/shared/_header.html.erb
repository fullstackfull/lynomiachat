<%# The header.

  Two rules the old page broke. First, every link points at a page that exists: the navigation is built from
  MarketingHelper::NAV_SECTIONS filtered to routes that are actually defined, so a section that has not
  shipped yet cannot appear as a dead link. Second, the language control is a LINK to the sibling URL, not a
  button that rewrites the DOM -- language is a URL decision (D5).
%>
<header class="sticky top-0 z-40 border-b border-slate-100 bg-white/90 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center gap-4 px-4 py-3 sm:px-6">
    <a href="<%= marketing_path(:home) %>" class="flex items-center gap-2 font-semibold text-slate-900">
      <span class="text-lg"><%= t('marketing.brand.name') %></span>
      <span class="text-lg text-woot-700"><%= t('marketing.brand.suffix') %></span>
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="<%= t('marketing.nav.label') %>">
      <% marketing_nav('header').each do |item| %>
        <a href="<%= item[:href] %>"
           class="rounded-lg px-3 py-2 text-sm text-slate-700 hover:bg-slate-50 hover:text-slate-900">
          <%= item[:label] %>
        </a>
      <% end %>
      <a href="<%= lynomia_docs_path %>"
         class="rounded-lg px-3 py-2 text-sm text-slate-700 hover:bg-slate-50 hover:text-slate-900">
        <%= t('marketing.nav.docs') %>
      </a>
    </nav>

    <div class="ms-auto flex items-center gap-2">
      <a href="<%= marketing_path(marketing_page, locale: marketing_other_locale) %>"
         class="rounded-lg border border-slate-200 px-3 py-1.5 text-xs font-medium text-slate-700 hover:bg-slate-50"
         lang="<%= marketing_other_locale %>"
         hreflang="<%= marketing_other_locale %>">
        <%= t('marketing.nav.other_locale') %>
      </a>
      <a href="/app/login" class="hidden rounded-lg px-3 py-2 text-sm text-slate-700 hover:text-slate-900 sm:block">
        <%= t('marketing.nav.sign_in') %>
      </a>
      <a href="/app/register"
         class="rounded-lg bg-woot-700 px-4 py-2 text-sm font-semibold text-white hover:bg-woot-800">
        <%= t('marketing.nav.get_started') %>
      </a>
    </div>
  </div>

  <nav class="flex gap-1 overflow-x-auto border-t border-slate-100 px-4 py-2 md:hidden"
       aria-label="<%= t('marketing.nav.label') %>">
    <% marketing_nav('header').each do |item| %>
      <a href="<%= item[:href] %>" class="whitespace-nowrap rounded-lg px-3 py-1.5 text-sm text-slate-700">
        <%= item[:label] %>
      </a>
    <% end %>
    <a href="<%= lynomia_docs_path %>" class="whitespace-nowrap rounded-lg px-3 py-1.5 text-sm text-slate-700">
      <%= t('marketing.nav.docs') %>
    </a>
  </nav>
</header>
