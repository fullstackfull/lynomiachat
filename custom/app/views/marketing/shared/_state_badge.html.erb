<%# Availability, shown rather than hidden.

  The inventory classifies every capability as available, conditional or beta, and a conditional feature needs
  a named prerequisite before a reader can use it. Rendering the state beside the name is what stops this site
  repeating the old one's six over-claims; an available feature needs no badge, so only the exceptions carry one.
%>
<% if state == :conditional %>
  <span class="rounded-full border border-yellow-200 bg-yellow-50 px-2 py-0.5 text-[11px] font-medium text-yellow-800">
    <%= t('marketing.state.conditional') %>
  </span>
<% elsif state == :beta %>
  <span class="rounded-full border border-violet-200 bg-violet-50 px-2 py-0.5 text-[11px] font-medium text-violet-800">
    <%= t('marketing.state.beta') %>
  </span>
<% end %>
