<nav class="flex flex-wrap gap-1 mb-6 border-b border-slate-100" role="navigation">
  <%#
    Ordered the way an operator works: is it on and healthy, how is it set up, then the three record kinds
    (customers, invoices, transactions), then the raw feed, what is broken, and the proofs.
  %>
  <%
    tabs = [
      ['Overview', super_admin_odoo_accounting_path],
      ['Connection &amp; Settings'.html_safe, settings_super_admin_odoo_accounting_path],
      ['Customers', customers_super_admin_odoo_accounting_path],
      ['Invoices', invoices_super_admin_odoo_accounting_path],
      ['Transactions', transactions_super_admin_odoo_accounting_path],
      ['Sync history', history_super_admin_odoo_accounting_path],
      ['Errors', errors_super_admin_odoo_accounting_path],
      ['Diagnostics', diagnostics_super_admin_odoo_accounting_path],
      ['Historical import', import_super_admin_odoo_accounting_path]
    ]
  %>
  <% tabs.each do |label, url| %>
    <% active = current_page?(url) %>
    <%= link_to label, url,
                class: "px-3 py-2 text-sm border-b-2 #{active ? 'border-woot-500 text-woot-500' : 'border-transparent text-slate-600 hover:text-woot-500'}" %>
  <% end %>
</nav>
